#!  /bin/bash


CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="db-create"
printf "${CYAN}== ${LABEL}${NO_COLOR}\n"

echo "Connecting to" $CONNECTION_URL

NO_DB_CONNECTION_URL=$(echo "$CONNECTION_URL" | sed 's/\/crudder$//')

echo "No DB URL" $NO_DB_CONNECTION_URL

psql $NO_DB_CONNECTION_URL -c "CREATE DATABASE crudder;"