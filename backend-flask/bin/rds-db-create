#!  /bin/bash


CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="rds-db-create"
printf "${CYAN}== ${LABEL}${NO_COLOR}\n"

echo "Connecting to" $PROD_CONNECTION_URL

NO_DB_PROD_URL=$(echo "$PROD_CONNECTION_URL" | sed 's/\/crudder$//')

echo "No DB URL" $NO_DB_PROD_URL

psql $NO_DB_PROD_URL -c "CREATE DATABASE crudder;"