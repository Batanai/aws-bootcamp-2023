#!  /bin/bash

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="db-seed"
printf "${CYAN}== ${LABEL}${NO_COLOR}\n"

seed_path=$(realpath .)/db/seed.sql
echo $seed_path

if [ "$1" = "prod" ]; then
    echo "using production"
    URL=$PROD_CONNECTION_URL
else
    echo "using development"
    URL=$CONNECTION_URL
fi

echo "Database connected to" $URL
psql $URL crudder < $seed_path